{
  "version": 1,
  "kbHome": ".",
  "name": "<kb-name>",
  "remote": "<owner>/<repo>",
  "description": "<one-line description of what this KB covers>",
  "topics": ["<topic>", "<alias>", "<domain keyword>"],
  "defaults": {
    "watermarkFile": ".state.json",
    "contextFile": "CONTEXT.md",
    "indexFile": "kb.index.json"
  },
  "products": [
    {
      "key": "<product-key>",
      "section": "<product-key>",
      "name": "<human-readable product name>",
      "sourceRepo": "<owner>/<source-repo>",
      "repoMatch": {
        "remotes": ["<owner>/<source-repo>"],
        "folderNames": ["<source-repo>"],
        "pathContains": ["<owner>/<source-repo>"]
      }
    }
  ]
}
